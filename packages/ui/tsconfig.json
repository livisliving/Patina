{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/components/ui/*": ["./src/registry/y2k/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
