{
  "name": "patina",
  "private": true,
  "version": "0.0.1",
  "description": "Patina — taste packs for AI coding agents. Y2K is pack #1.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web && npm run lint -w @patina/ui",
    "design:lint": "design.md lint DESIGN.md",
    "design:export": "design.md export --format css-tailwind DESIGN.md",
    "check:y2k": "node scripts/check-y2k.mjs apps/web packages",
    "registry:build": "npm run build -w @patina/ui && node scripts/registry-base.mjs",
    "figma:foundations": "node scripts/figma/foundations.mjs",
    "figma:tone": "node scripts/figma/tone.mjs"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
